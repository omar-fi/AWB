@startuml Diagramme_CasUtilisation_AWB_Clair

skinparam backgroundColor #FAFAFA
skinparam defaultFontName Arial
skinparam roundcorner 10
skinparam actorStyle awesome
left to right direction

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #E8391D
    FontColor #1A1A1A
    ArrowColor #E8391D
}

skinparam actor {
    BackgroundColor #1A1A1A
    FontColor #FFFFFF
    BorderColor #E8391D
}

title AWB IA Predictive -- Diagramme de Cas d'Utilisation (Simplifie et Clair)

' ACTEURS
actor "Conseiller" as CONS
actor "Analyste Risques\n(Portefeuilleur)" as ANALYST
actor "Directeur" as DIR
actor "Systeme IA" as IA <<System>>

' HERITAGE
ANALYST -|> CONS
DIR -|> ANALYST

rectangle "Plateforme AWB IA Predictive" {

    package "Operations Quotidiennes" {
        usecase "Gerer les visites du jour" as UC1
        usecase "Enregistrer un resultat de vente" as UC2
        usecase "Consulter l'agenda des predictions" as UC3
    }

    package "Expertise & IA" {
        usecase "Analyser le diagnostic IA\n(Insight + Strategie)" as UC4
        usecase "Evaluer le niveau de risque\net churn" as UC5
        usecase "Deleguer une instruction\nau conseiller" as UC6
    }

    package "Gestion & Pilotage" {
        usecase "Gerer le portefeuille clients\n(CRUD)" as UC7
        usecase "Suivre les KPI et la\nperformance agence" as UC8
        usecase "Visualiser la sante du\nportefeuille" as UC9
    }

    package "Traitements Automatiques" {
        usecase "Generer les predictions\nnocturnes" as UC10
        usecase "Calculer les scores IA\n(XGBoost)" as UC11
        usecase "Generer les insights\n(LLM Groq)" as UC12
    }
}

' RELATIONS UTILISATEURS
CONS --> UC1
CONS --> UC2
CONS --> UC3

ANALYST --> UC4
ANALYST --> UC5
ANALYST --> UC6

DIR --> UC7
DIR --> UC8
DIR --> UC9

' RELATIONS SYSTEME IA
IA --> UC10
UC10 ..> UC11 : <<include>>
UC10 ..> UC12 : <<include>>

' DEPENDANCES ENTRE CAS D'UTILISATION
UC1 ..> UC4 : <<extend>>\n(si autorise)
UC4 ..> UC5 : <<include>>
UC6 ..> UC1 : <<extend>>\n(instruction affichee)

note right of UC10
  Batch automatique
  chaque nuit a 00h00
end note

note bottom of DIR
  Le Directeur a tous les droits
  de l'Analyste et du Conseiller
end note

@enduml
