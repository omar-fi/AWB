@startuml Diagramme3_Dashboard_Frontend

skinparam backgroundColor #FAFAFA
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam ParticipantPadding 15
skinparam defaultFontName Arial

skinparam participant {
    BackgroundColor #2C2C2C
    FontColor #FFFFFF
    BorderColor #E8391D
}
skinparam sequence {
    ArrowColor #E8391D
    LifeLineBorderColor #AAAAAA
    LifeLineBackgroundColor #F0F0F0
    GroupBackgroundColor #E8F5E9
    GroupBorderColor #43A047
    NoteBackgroundColor #FFFBE6
    NoteBorderColor #FFC000
}

title AWB -- [3] Dashboard React (Keycloak OAuth2 + Spring Boot RBAC)

actor "Utilisateur\n(Conseiller / Portefeuilleur / Directeur)" as USER
participant "React Frontend\n(DashboardConseiller.jsx)" as REACT
participant "Keycloak\n(Auth Server)" as KC
participant "Spring Boot\n(predict-backend)" as SPRING
participant "MySQL\nattijari_predict_db" as DB

== Authentification OAuth2 / OIDC ==

USER -> REACT : Acces application (/)
REACT -> KC : Redirection login (OAuth2 PKCE)
KC --> USER : Formulaire de connexion AWB
USER -> KC : Identifiants (username + password)
KC -> KC : Verification credentials\n+ chargement roles (realm_access)
KC --> REACT : Access Token JWT\n{sub, role, agenceId, permissions[]}

REACT -> REACT : Stockage AuthContext :\n{user, role, agenceId, agenceNom,\nhasPermission(perm)}
note right of REACT
  Roles : CONSEILLER / PORTEFEUILLEUR / DIRECTEUR
  Permissions RBAC deleguees :
  - CAN_ANALYZE_CLIENTS
  - CAN_EDIT_CLIENT
  - CAN_DELETE_ACCOUNT
  - CAN_CREATE_ACCOUNT
  - CAN_VIEW_PORTFOLIO
end note

== Chargement des predictions ==

REACT -> SPRING : GET /api/v1/predictions/agence/{agenceId}\nAuthorization: Bearer {JWT}
activate SPRING
SPRING -> SPRING : Verification JWT (Keycloak Public Key)\n+ controle role / agence
SPRING -> DB : SELECT pv.*, c.*\nFROM prediction_visite pv\nJOIN client c ON pv.client_id = c.id\nWHERE c.agence_id = ?
activate DB
DB --> SPRING : [predictions enrichies]
deactivate DB
SPRING --> REACT : JSON [{id, scoreProbabiliteGlobal,\noperationPrevue, datePrevue,\nplageHorairePrevue, insightGenai,\nstrategiePrescrite, niveauRisque, client{}}]
deactivate SPRING

== Affichage conditionnel (RBAC) ==

REACT -> REACT : Filtrer : isToday(datePrevue)\n-> "Clients attendus aujourd'hui"

alt Role = PORTEFEUILLEUR / DIRECTEUR\nou permission CAN_ANALYZE_CLIENTS
    REACT -> REACT : Afficher PredictionCard (vue complete) :\n- Score probabilite + barre\n- Insight GenAI (LLM)\n- Strategie prescrite (rouge)\n- Niveau risque (badge colore)\n- Diagnostic IA (section collapsible)
else Role = CONSEILLER standard
    REACT -> REACT : Afficher ConseillerPredictionCard\n(vue simplifiee) :\n- Operation prevue\n- Service de retention\n- Bouton "Enregistrer vente"
end

== Instructions du Portefeuilleur ==

loop Pour chaque carte prediction visible
    REACT -> SPRING : GET /api/v1/actions/client/{id}/dernier-examen
    activate SPRING
    SPRING -> DB : SELECT * FROM action_client\nWHERE client_id=?\nAND type_delegation IN\n('ANALYSE_RISQUE','ACTION_DELEGUE')\nORDER BY date DESC LIMIT 1
    activate DB
    DB --> SPRING : ActionEntity {commentaire, typeDelegation}
    deactivate DB
    SPRING --> REACT : Instruction Portefeuilleur
    deactivate SPRING
    REACT -> REACT : Afficher bloc "Instruction Analyste Risques"
end

== Action banquier ==

USER -> REACT : Clic "Enregistrer resultat" (ActionModal)
REACT -> SPRING : POST /api/v1/actions\n{clientId, banquierId, commentaire,\ntypeDelegation, resultat}
activate SPRING
SPRING -> DB : INSERT INTO action_client
activate DB
DB --> SPRING : OK
deactivate DB
SPRING --> REACT : 201 Created [OK]
deactivate SPRING
REACT -> SPRING : GET /api/v1/predictions/agence/{agenceId}
note right of REACT : Rafraichissement des donnees

== Gestion Portefeuille Clients ==

USER -> REACT : Onglet "Portefeuille Clients"
REACT -> SPRING : GET /api/v1/clients/agence/{agenceId}?page=0&size=10
activate SPRING
SPRING -> DB : SELECT * FROM client\nWHERE agence_id=?\nLIMIT 10 OFFSET 0
activate DB
DB --> SPRING : Page<ClientEntity>
deactivate DB
SPRING --> REACT : {content[], totalPages, totalElements}
deactivate SPRING

alt Permission CAN_CREATE_ACCOUNT
    USER -> REACT : Clic "Nouveau client" (CreateClientModal)
    REACT -> SPRING : POST /api/v1/clients
    activate SPRING
    SPRING -> DB : INSERT INTO client
    DB --> SPRING : ClientEntity
    SPRING --> REACT : 201 Created
    deactivate SPRING
end

alt Permission CAN_EDIT_CLIENT
    USER -> REACT : Clic "Modifier" (EditClientModal)
    REACT -> SPRING : PUT /api/v1/clients/{id}
    activate SPRING
    SPRING -> DB : UPDATE client SET ...
    DB --> SPRING : OK
    SPRING --> REACT : 200 OK
    deactivate SPRING
end

alt DIRECTEUR ou Permission CAN_DELETE_ACCOUNT
    USER -> REACT : Clic "Supprimer"
    REACT -> SPRING : DELETE /api/v1/clients/{id}
    activate SPRING
    SPRING -> DB : DELETE FROM client WHERE id=?
    DB --> SPRING : OK
    SPRING --> REACT : 204 No Content
    deactivate SPRING
end

@enduml
