@startuml Diagramme_Architecture_AWB

skinparam backgroundColor #FAFAFA
skinparam defaultFontName Arial
skinparam roundcorner 10
skinparam componentStyle uml2

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #E8391D
    FontColor #1A1A1A
}

skinparam interface {
    BackgroundColor #E8391D
    BorderColor #E8391D
}

skinparam database {
    BackgroundColor #FFFFFF
    BorderColor #37474F
}

skinparam package {
    BackgroundColor #FFF7E6
    BorderColor #FFC000
}

title AWB IA Predictive -- Architecture Technique et Fonctionnelle

package "Tier 1 : Presentation (Frontend)" {
    component "React Dashboard\n(Vite + Tailwind)" as UI #FEF9E7
    interface "UI / UX" as UX
}

package "Tier 2 : Logique Metier (Backend)" {
    component "Spring Boot API\n(REST Controllers)" as API #EBF5FB
    component "Security Manager\n(Keycloak Adapter)" as SEC #EAFAF1
    component "Service Layer\n(Spring Data JPA)" as SVC #EBF5FB
}

package "Tier 3 : Intelligence Artificielle" {
    component "Agent IA\n(FastAPI / MCP)" as AGENT #FDEDEC
    component "Moteur IA\n(XGBoost + LLM)" as ENGINE #FDEDEC
    component "Scheduler\n(Cron Job)" as CRON #F4F6F7
}

package "Tier 4 : Persistance des Donnees" {
    database "MySQL Database\n(attijari_predict_db)" as DB
}

' Relations
UI -- API : REST / JSON (JWT)
API -- SEC : Verifie Token
API -- SVC : Appels Metier
SVC -- DB : CRUD Operations

API -- AGENT : Requêtes Recalcul
CRON -- ENGINE : Batch Nocturne (00h00)
ENGINE -- DB : Stockage Predictions
AGENT -- ENGINE : Orchestration

note top of UI : ReactJS, TailwindCSS,\nLucide Icons, Keycloak-js
note bottom of API : Java 17, Spring Boot,\nSpring Security, Hibernate
note bottom of ENGINE : Python 3.10, XGBoost,\nLangChain, Groq (Llama 3.1)
note bottom of DB : Tables : Client, Compte,\nPredictionVisite, ActionConseiller

@enduml
