@startuml Diagramme4_Stats_KPI

skinparam backgroundColor #FAFAFA
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam ParticipantPadding 15
skinparam defaultFontName Arial

skinparam participant {
    BackgroundColor #2C2C2C
    FontColor #FFFFFF
    BorderColor #E8391D
}
skinparam sequence {
    ArrowColor #E8391D
    LifeLineBorderColor #AAAAAA
    LifeLineBackgroundColor #F0F0F0
    GroupBackgroundColor #FFF3E0
    GroupBorderColor #4c320bff
    NoteBackgroundColor #FFFBE6
    NoteBorderColor #FFC000
}

title AWB -- [4] Statistiques & KPI Agence (Directeur)

actor "Directeur\nd'Agence" as DIR
participant "React Frontend" as REACT
participant "StatsController\n(Spring Boot)" as STATS
participant "DashboardService\n(Spring Boot)" as SVC
participant "MySQL\nattijari_predict_db" as DB

== Sante du Portefeuille ==

DIR -> REACT : Acces vue "Sante du Portefeuille"

REACT -> STATS : GET /api/v1/stats/risques?agenceId=X\nAuthorization: Bearer {JWT}
activate STATS
STATS -> SVC : obtenirStatsRisques(agenceId)
activate SVC
SVC -> DB : SELECT niveau_risque, COUNT(*) AS nb\nFROM prediction_visite pv\nJOIN client c ON pv.client_id = c.id\nWHERE c.agence_id = X\nGROUP BY niveau_risque
activate DB
DB --> SVC : [{FAIBLE: n1}, {ALERTE: n2},\n{ELEVE: n3}, {CRITIQUE: n4}]
deactivate DB
SVC --> STATS : Map<String, Object>
deactivate SVC
STATS --> REACT : JSON stats risques
deactivate STATS

REACT -> REACT : Afficher graphiques :\n- Donut par niveau de risque\n- Nb clients par categorie

== Performance Agence / KPI ==

DIR -> REACT : Acces vue "Performance Agence"

REACT -> STATS : GET /api/v1/admin/kpi?agenceId=X\nAuthorization: Bearer {JWT}
activate STATS
STATS -> SVC : obtenirAdminKpi(agenceId)
activate SVC

SVC -> DB : SELECT\n  COUNT(*) AS total_predictions,\n  AVG(score_probabilite_global) AS score_moyen,\n  COUNT(CASE WHEN date_prevue = CURDATE()\n        THEN 1 END) AS visites_aujourd_hui\nFROM prediction_visite pv\nJOIN client c ON pv.client_id = c.id\nWHERE c.agence_id = X
activate DB
DB --> SVC : {total, score_moyen, visites_jour}
deactivate DB

SVC -> DB : SELECT COUNT(*) AS actions_enregistrees,\n  type_delegation, COUNT(*) AS nb\nFROM action_client ac\nJOIN client c ON ac.client_id = c.id\nWHERE c.agence_id = X\nGROUP BY type_delegation
activate DB
DB --> SVC : {nb_actions, repartition_types}
deactivate DB

SVC --> STATS : KPI agreges
deactivate SVC
STATS --> REACT : JSON KPI complet
deactivate STATS

REACT -> REACT : Afficher dashboard KPI :\n- Score moyen portefeuille\n- Clients a risque critique\n- Visites prevues aujourd'hui\n- Taux actions enregistrees\n- Repartition par type delegation

@enduml
