@startuml AWB_IA_Predictive

!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam ParticipantPadding 20
skinparam BoxPadding 12

skinparam participant {
    BackgroundColor #1A1A1A
    FontColor #FFFFFF
    BorderColor #E8391D
}
skinparam sequence {
    ArrowColor #E8391D
    LifeLineBorderColor #CCCCCC
    LifeLineBackgroundColor #F5F5F5
    GroupBackgroundColor #FFF7E6
    GroupBorderColor #FFC000
    DividerBackgroundColor #F0F0F0
    DividerBorderColor #CCCCCC
    NoteBackgroundColor #FFFBE6
    NoteBorderColor #FFC000
}

' ════════════════════════════════════════════════════════════════
'  DIAGRAMME 1 — BATCH NOCTURNE AUTOMATIQUE
' ════════════════════════════════════════════════════════════════

title **[1/5] AWB — Batch Nocturne (Scheduler → consumer_ia.py)**

participant "⏰ Scheduler\n(scheduler.py)" as SCHED #2C2C2C
participant "🌙 NightlyBatch\n(nightly_batch.py)" as BATCH #1A1A1A
participant "🧠 ConsumerIA\n(consumer_ia.py)" as CONSUMER #1A1A1A
participant "📦 XGBoost Models\n(.pkl)" as XGB #2E4057
participant "💬 Groq LLM\n(llama-3.1-8b)" as LLM #2E7D32
participant "🗄️ MySQL\n(attijari_predict_db)" as DB #37474F

== Démarrage du daemon ==

SCHED -> SCHED : Calculer secondes avant minuit (UTC+1 Maroc)
SCHED -> SCHED : sleep(secondes_restantes)
note right of SCHED
  Déclenché chaque nuit à **00h00**
  heure Maroc (UTC+1 fixe)
end note

== Batch MINUIT ==

SCHED -> BATCH : batch_main()  [MINUIT / DEMARRAGE / MANUEL]
activate BATCH

BATCH -> DB : SELECT id FROM client
activate DB
DB --> BATCH : [liste client_ids]
deactivate DB

loop Pour chaque client_id

    BATCH -> CONSUMER : recalculer_prediction(client_id, "BATCH")
    activate CONSUMER

    ' — Récupération dernière opération réelle —
    CONSUMER -> DB : SELECT type_op, montant\nFROM historique_operation\nWHERE client_id=? ORDER BY date DESC LIMIT 1
    activate DB
    DB --> CONSUMER : {type_op, montant, event_time}
    deactivate DB

    ' — Récupération profil complet —
    CONSUMER -> DB : SELECT segment_metier, solde, has_epargne\nCOUNT(ops), AVG(montant), nb_ops_30j
    activate DB
    DB --> CONSUMER : profil_agrege
    deactivate DB

    ' — Prédiction probabilité de visite —
    CONSUMER -> XGB : predict_proba(features_visite[24 colonnes])
    activate XGB
    XGB --> CONSUMER : raw_proba [0.0 – 1.0]
    deactivate XGB

    CONSUMER -> CONSUMER : Ajustement métier (VIP+5%, PRO+3%)\nprobabilite_finale = min(raw*coeff*100, 99)

    ' — Prédiction date/heure/opération —
    alt probabilite >= 85%
        CONSUMER -> CONSUMER : Règle métier :\ndate = AUJOURD'HUI (si jour ouvrable)
    else probabilite < 85%
        CONSUMER -> XGB : predict(xgboost_next_date.pkl)\npredict(xgboost_next_time.pkl)\npredict(xgboost_next_operation.pkl)
        activate XGB
        XGB --> CONSUMER : delta_jours, heure_float, op_encodee
        deactivate XGB
        CONSUMER -> CONSUMER : _next_jour_ouvre(candidate)\n→ exclure dimanches + jours fériés Maroc
    end

    ' — Opération prévue depuis historique —
    CONSUMER -> DB : SELECT type_operation, COUNT(*) AS freq\nGROUP BY type_operation ORDER BY freq DESC LIMIT 1
    activate DB
    DB --> CONSUMER : operation_dominante
    deactivate DB

    ' — Score churn et stratégie —
    CONSUMER -> CONSUMER : Calcul score_churn :\n• Critère solde (ratio < 0.4 → +0.6)\n• Critère retraits massifs (+0.4)\n• Critère inactivité soudaine (+0.5)
    CONSUMER -> CONSUMER : determiner_strategie(segment, score_churn, solde)\ncalculer_niveau_risque(score_churn)\n→ FAIBLE / ALERTE / ÉLEVÉ / CRITIQUE

    ' — Génération insight LLM —
    CONSUMER -> LLM : Prompt Groq :\n"Segment: {seg} | Solde: {solde} MAD |\nOps 30j: {n} | Risque: {niveau}\nPrédis Santé + Stratégie de rétention"
    activate LLM
    LLM --> CONSUMER : "Santé : [diagnostic] | Stratégie : [action]"
    deactivate LLM

    CONSUMER -> CONSUMER : Extraire stratégie_llm\n(split sur "Stratégie :")

    ' — Sauvegarde en base —
    CONSUMER -> DB : UPSERT prediction_visite\n(score, op_prevue, date_prevue,\nplage_horaire, insight_genai,\nstrategie, niveau_risque, NOW())
    activate DB
    DB --> CONSUMER : OK
    deactivate DB

    CONSUMER --> BATCH : ✅ Client traité
    deactivate CONSUMER

end

== Distribution par horizon ==

BATCH -> DB : SELECT date_prevue, score, niveau_risque\nFROM prediction_visite ORDER BY score DESC
activate DB
DB --> BATCH : [predictions]
deactivate DB

BATCH -> BATCH : classifier_horizon(date_prevue)\n→ AUJOURD'HUI / DEMAIN / CETTE_SEMAINE\n   CE_MOIS / MOIS_PROCHAIN / PLUS_TARD

BATCH --> SCHED : Batch terminé en Xs — Batch #N ✅
deactivate BATCH

@enduml

@startuml AWB_Agent_MCP

!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam ParticipantPadding 20

skinparam participant {
    BackgroundColor #1A1A1A
    FontColor #FFFFFF
    BorderColor #E8391D
}
skinparam sequence {
    ArrowColor #E8391D
    LifeLineBorderColor #CCCCCC
    GroupBackgroundColor #FFF7E6
    GroupBorderColor #FFC000
    NoteBackgroundColor #FFFBE6
    NoteBorderColor #FFC000
}

' ════════════════════════════════════════════════════════════════
'  DIAGRAMME 2 — AGENT IA VIA PROTOCOLE MCP
' ════════════════════════════════════════════════════════════════

title **[2/5] AWB — Agent IA (agent_ia.py ↔ mcp_ia_server.py)**

participant "🤖 Agent IA\n(agent_ia.py)" as AGENT #1A1A1A
participant "🔌 MCP Server\n(mcp_ia_server.py)" as MCP #2C2C2C
participant "📦 XGBoost Models" as XGB #2E4057
participant "💬 Groq LLM" as LLM #2E7D32
participant "🗄️ MySQL" as DB #37474F

== Initialisation ==

AGENT -> AGENT : asyncio.run(run_agent())
AGENT -> MCP : StdioServerParameters\n(subprocess Python mcp_ia_server.py)
activate MCP
MCP --> AGENT : Session MCP initialisée ✅
note right of MCP
  FastMCP expose 4 tools :
  • get_client_history
  • predict_visite
  • calculate_risk_and_strategy
  • generate_insight
end note

AGENT -> DB : SELECT id FROM client
activate DB
DB --> AGENT : [liste clients]
deactivate DB

== Traitement par client ==

loop Pour chaque client_id

    ' TOOL 1 — Historique
    AGENT -> MCP : call_tool("get_client_history",\n{client_id: X})
    activate MCP
    MCP -> DB : SELECT segment, solde, has_epargne,\nAVG(montant), COUNT(ops), last_op
    activate DB
    DB --> MCP : données agrégées
    deactivate DB
    MCP --> AGENT : profil_json (dict complet)
    deactivate MCP

    ' TOOL 2 — Prédiction visite
    AGENT -> MCP : call_tool("predict_visite",\n{profil_json: "..."})
    activate MCP
    MCP -> XGB : predict_proba(xgboost_optimise.pkl)
    activate XGB
    XGB --> MCP : score_probabilite [0–99%]
    deactivate XGB
    MCP -> XGB : predict(next_date, next_time, next_operation)
    activate XGB
    XGB --> MCP : delta_jours, heure, op_encodee
    deactivate XGB
    MCP -> MCP : _next_jour_ouvre() + contraintes horaires AWB
    MCP --> AGENT : {score, operation_prevue,\ndate_prevue, plage_horaire, statut}
    deactivate MCP

    ' TOOL 3 — Risque & Stratégie
    AGENT -> MCP : call_tool("calculate_risk_and_strategy",\n{profil_json: "..."})
    activate MCP
    MCP -> MCP : Calcul score_churn multi-critères\n(solde, retraits, inactivité)
    MCP -> MCP : Niveau : FAIBLE / ALERTE / CRITIQUE\nStratégie : règles métier déterministes
    MCP --> AGENT : {score_churn, niveau_risque,\nstrategie_prescrite}
    deactivate MCP

    ' TOOL 4 — Insight LLM
    AGENT -> MCP : call_tool("generate_insight",\n{profil_json, prediction_json, risque_json})
    activate MCP
    MCP -> LLM : Prompt Groq (contexte complet client)
    activate LLM
    LLM --> MCP : "Santé : [attrition/fidélité] |\nStratégie : [action rétention]"
    deactivate LLM
    MCP --> AGENT : insight_text
    deactivate MCP

    ' Extraction & sauvegarde
    AGENT -> AGENT : Extraire stratégie_llm\n(split "Stratégie :")
    AGENT -> DB : UPSERT prediction_visite\n(score, op, date, insight,\nstrategie, risque, NOW())
    activate DB
    DB --> AGENT : OK ✅
    deactivate DB

end

AGENT -> MCP : Fermer session MCP
deactivate MCP
AGENT -> AGENT : 🏁 Agent IA — Mission terminée

@enduml

