' ════════════════════════════════════════════════════════════════
'  DIAGRAMME 4 — STATISTIQUES & KPI (DIRECTEUR)
' ════════════════════════════════════════════════════════════════

title **[4/5] AWB — Statistiques & KPI Agence (Directeur)**

actor "👔 Directeur" as DIR
participant "⚛️ React" as REACT #1A1A1A
participant "🌱 StatsController\n(Spring Boot)" as STATS #1A237E
participant "🌱 DashboardService\n(Spring Boot)" as SVC #283593
participant "🗄️ MySQL" as DB #37474F

== Santé du Portefeuille ==

DIR -> REACT : Accès vue "Santé du Portefeuille"
REACT -> STATS : GET /api/v1/stats/risques?agenceId=X\nAuthorization: Bearer {JWT}
activate STATS
STATS -> SVC : obtenirStatsRisques(agenceId)
activate SVC
SVC -> DB : SELECT niveau_risque, COUNT(*) AS nb\nFROM prediction_visite pv\nJOIN client c ON pv.client_id = c.id\nWHERE c.agence_id = X\nGROUP BY niveau_risque
activate DB
DB --> SVC : [{FAIBLE: n1}, {ALERTE: n2},\n{ÉLEVÉ: n3}, {CRITIQUE: n4}]
deactivate DB
SVC --> STATS : Map<String, Object>
deactivate SVC
STATS --> REACT : JSON stats risques
deactivate STATS

REACT -> REACT : Afficher graphiques\n(donut par niveau de risque)

== Performance Agence / KPI ==

DIR -> REACT : Accès vue "Performance Agence"
REACT -> STATS : GET /api/v1/admin/kpi?agenceId=X\nAuthorization: Bearer {JWT}
activate STATS
STATS -> SVC : obtenirAdminKpi(agenceId)
activate SVC

SVC -> DB : SELECT\nCOUNT(*) as total_predictions,\nAVG(score_probabilite_global) as score_moyen,\nCOUNT(CASE WHEN date_prevue = CURDATE() THEN 1 END) as visites_aujourd_hui\nFROM prediction_visite pv\nJOIN client c ON pv.client_id = c.id\nWHERE c.agence_id = X
activate DB
DB --> SVC : {total, score_moyen, visites_jour}
deactivate DB

SVC -> DB : SELECT COUNT(*) as actions_enregistrees,\ntypeDelegation, COUNT(*) as nb\nFROM action_client ac\nJOIN client c ON ac.client_id = c.id\nWHERE c.agence_id = X\nGROUP BY typeDelegation
activate DB
DB --> SVC : {nb_actions, repartition_types}
deactivate DB

SVC --> STATS : KPI agrégés
deactivate SVC
STATS --> REACT : JSON KPI complet
deactivate STATS

REACT -> REACT : Afficher dashboard KPI :\n• Score moyen portefeuille\n• Clients à risque critique\n• Visites prévues aujourd'hui\n• Taux d'actions enregistrées

@enduml

